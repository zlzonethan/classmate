rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function userProfile(uid) {
      return get(/databases/$(database)/documents/users/$(uid));
    }

    function userRole(uid) {
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(uid))
        ? userProfile(uid).data.role
        : 'STUDENT';
    }

    function isTeacherOrClassPresident() {
      return isSignedIn() && (
        userRole(request.auth.uid) == 'TEACHER' ||
        userRole(request.auth.uid) == 'CLASS_PRESIDENT'
      );
    }

    match /classes/{classId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isTeacherOrClassPresident();
    }

    match /users/{uid} {
      allow create: if isOwner(uid)
        && request.resource.data.uid == uid
        && request.resource.data.email is string
        && request.resource.data.classId is string
        && request.resource.data.role == 'STUDENT'
        && request.resource.data.keys().hasOnly([
          'uid', 'displayName', 'email', 'photoURL', 'bio', 'status',
          'role', 'classId', 'createdAt', 'updatedAt'
        ]);
      allow read: if isOwner(uid);
      allow update: if isOwner(uid)
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.role == resource.data.role
        && request.resource.data.classId == resource.data.classId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'displayName', 'email', 'photoURL', 'bio', 'status', 'updatedAt'
        ]);
      allow delete: if false;
    }

    match /homework/{homeworkId} {
      allow read: if isSignedIn();
      allow create, update: if isTeacherOrClassPresident();
      allow delete: if isTeacherOrClassPresident();
    }

    match /subjects/{subjectId} {
      allow read: if isSignedIn();
      allow create: if isTeacherOrClassPresident()
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 40
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.archived == false
        && request.resource.data.keys().hasOnly([
          'name', 'color', 'archived', 'createdAt', 'updatedAt', 'createdBy'
        ]);
      allow update: if isTeacherOrClassPresident()
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'name', 'color', 'archived', 'updatedAt'
        ])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 40;
      allow delete: if isTeacherOrClassPresident();
    }

    match /announcements/{announcementId} {
      allow read: if isSignedIn();
      allow create: if isTeacherOrClassPresident()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 120
        && request.resource.data.content is string
        && request.resource.data.content.size() > 0
        && request.resource.data.content.size() <= 5000
        && request.resource.data.pinned is bool
        && request.resource.data.archived == false
        && request.resource.data.keys().hasOnly([
          'title', 'content', 'pinned', 'attachmentUrls', 'createdBy',
          'createdAt', 'updatedAt', 'archived', 'authorName', 'slug'
        ]);
      allow update: if isTeacherOrClassPresident()
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'title', 'content', 'pinned', 'updatedAt'
        ])
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 120
        && request.resource.data.content is string
        && request.resource.data.content.size() > 0
        && request.resource.data.content.size() <= 5000
        && request.resource.data.pinned is bool;
      allow delete: if isTeacherOrClassPresident();
    }

    match /events/{eventId} {
      allow read: if isSignedIn()
        && (resource.data.isPublic == true || resource.data.createdBy == request.auth.uid);
      allow create: if isSignedIn()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 100
        && request.resource.data.date is string
        && request.resource.data.isPublic is bool
        && request.resource.data.description is string
        && request.resource.data.time is string
        && request.resource.data.type in ['Homework', 'Test', 'Reminder', 'Event']
        && request.resource.data.keys().hasOnly([
          'title', 'description', 'date', 'time', 'type', 'isPublic',
          'createdBy', 'createdAt', 'updatedAt', 'archived'
        ]);
      allow update: if isSignedIn()
        && resource.data.createdBy == request.auth.uid
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'title', 'description', 'date', 'time', 'type', 'isPublic', 'updatedAt'
        ])
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 100
        && request.resource.data.date is string
        && request.resource.data.isPublic is bool
        && request.resource.data.description is string
        && request.resource.data.time is string
        && request.resource.data.type in ['Homework', 'Test', 'Reminder', 'Event'];
      allow delete: if isSignedIn()
        && resource.data.createdBy == request.auth.uid;
    }

    match /tests/{testId} {
      allow read: if isSignedIn();
      allow create, update: if isTeacherOrClassPresident();
      allow delete: if isTeacherOrClassPresident();
    }

    match /homeworkSubmissions/{submissionId} {
      allow read: if isSignedIn() && (
        resource.data.uid == request.auth.uid ||
        isTeacherOrClassPresident()
      );
      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.homeworkId is string
        && exists(/databases/$(database)/documents/homework/$(request.resource.data.homeworkId))
        && request.resource.data.homeworkTitle is string
        && request.resource.data.studentName is string
        && request.resource.data.status == 'PENDING'
        && request.resource.data.createdAt is string
        && request.resource.data.updatedAt is string
        && request.resource.data.evidenceIds is list
        && request.resource.data.evidenceIds.size() > 0
        && request.resource.data.evidenceIds.size() <= 5
        && request.resource.data.keys().hasOnly([
          'uid', 'studentName', 'homeworkId', 'homeworkTitle', 'status',
          'createdAt', 'updatedAt', 'evidenceIds'
        ]);
      allow update: if isSignedIn() && (
        (
          isTeacherOrClassPresident()
          && resource.data.status == 'PENDING'
          && resource.data.uid != request.auth.uid
          && request.resource.data.uid == resource.data.uid
          && request.resource.data.homeworkId == resource.data.homeworkId
          && request.resource.data.homeworkTitle == resource.data.homeworkTitle
          && request.resource.data.studentName == resource.data.studentName
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.status in ['APPROVED', 'REJECTED']
          && request.resource.data.reviewedBy == request.auth.uid
          && request.resource.data.reviewedAt is string
          && (
            request.resource.data.status == 'REJECTED' ||
            (
              existsAfter(/databases/$(database)/documents/xpTransactions/$(submissionId))
              && getAfter(/databases/$(database)/documents/xpTransactions/$(submissionId)).data.uid == resource.data.uid
              && getAfter(/databases/$(database)/documents/xpTransactions/$(submissionId)).data.homeworkId == resource.data.homeworkId
              && getAfter(/databases/$(database)/documents/xpTransactions/$(submissionId)).data.amount == 10
            )
          )
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'status', 'reviewedBy', 'reviewedAt'
          ])
        ) ||
        (
          resource.data.uid == request.auth.uid
          && resource.data.status == 'REJECTED'
          && request.resource.data.status == 'PENDING'
          && request.resource.data.evidenceIds is list
          && request.resource.data.evidenceIds.size() > resource.data.evidenceIds.size()
          && request.resource.data.evidenceIds.size() <= 5
          && request.resource.data.uid == resource.data.uid
          && request.resource.data.homeworkId == resource.data.homeworkId
          && request.resource.data.homeworkTitle == resource.data.homeworkTitle
          && request.resource.data.studentName == resource.data.studentName
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.updatedAt is string
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'status', 'updatedAt', 'evidenceIds'
          ])
        )
      );
      allow delete: if false;

      match /evidence/{evidenceId} {
        allow read: if isSignedIn() && (
          resource.data.uid == request.auth.uid ||
          isTeacherOrClassPresident()
        );
        allow create: if isSignedIn()
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 120
          && request.resource.data.dataUrl is string
          && request.resource.data.dataUrl.size() <= 650000
          && request.resource.data.createdAt is string
          && existsAfter(/databases/$(database)/documents/homeworkSubmissions/$(submissionId))
          && getAfter(/databases/$(database)/documents/homeworkSubmissions/$(submissionId)).data.uid == request.auth.uid
          && getAfter(/databases/$(database)/documents/homeworkSubmissions/$(submissionId)).data.status == 'PENDING'
          && evidenceId in getAfter(/databases/$(database)/documents/homeworkSubmissions/$(submissionId)).data.evidenceIds
          && request.resource.data.keys().hasOnly(['uid', 'name', 'dataUrl', 'createdAt']);
        allow update, delete: if false;
      }
    }

    match /xpTransactions/{transactionId} {
      allow read: if isSignedIn() && (
        resource.data.uid == request.auth.uid ||
        isTeacherOrClassPresident()
      );
      allow create: if isTeacherOrClassPresident()
        && request.resource.data.submissionId == transactionId
        && request.resource.data.uid is string
        && request.resource.data.homeworkId is string
        && request.resource.data.amount == 10
        && request.resource.data.reason == 'Approved homework completion'
        && request.resource.data.createdAt is string
        && existsAfter(/databases/$(database)/documents/homeworkSubmissions/$(transactionId))
        && getAfter(/databases/$(database)/documents/homeworkSubmissions/$(transactionId)).data.status == 'APPROVED'
        && getAfter(/databases/$(database)/documents/homeworkSubmissions/$(transactionId)).data.uid == request.resource.data.uid
        && getAfter(/databases/$(database)/documents/homeworkSubmissions/$(transactionId)).data.homeworkId == request.resource.data.homeworkId
        && request.resource.data.keys().hasOnly([
          'uid', 'homeworkId', 'submissionId', 'amount', 'reason', 'createdAt'
        ]);
      allow update, delete: if false;
    }

    match /aiUsage/{usageId} {
      allow read: if isSignedIn();
      allow create, update: if isTeacherOrClassPresident();
      allow delete: if isTeacherOrClassPresident();
    }
  }
}
