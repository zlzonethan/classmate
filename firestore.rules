rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function userProfile(uid) {
      return get(/databases/$(database)/documents/users/$(uid));
    }

    function userRole(uid) {
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(uid))
        ? userProfile(uid).data.role
        : 'STUDENT';
    }

    function isTeacherOrClassPresident() {
      return isSignedIn() && (
        userRole(request.auth.uid) == 'TEACHER' ||
        userRole(request.auth.uid) == 'CLASS_PRESIDENT'
      );
    }

    match /classes/{classId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isTeacherOrClassPresident();
    }

    match /users/{uid} {
      allow create: if isOwner(uid)
        && request.resource.data.uid == uid
        && request.resource.data.email is string
        && request.resource.data.classId is string
        && request.resource.data.role == 'STUDENT'
        && request.resource.data.keys().hasOnly([
          'uid', 'displayName', 'email', 'photoURL', 'bio', 'status',
          'role', 'classId', 'createdAt', 'updatedAt'
        ]);
      allow read: if isOwner(uid);
      allow update: if isOwner(uid)
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.role == resource.data.role
        && request.resource.data.classId == resource.data.classId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'displayName', 'email', 'photoURL', 'bio', 'status', 'updatedAt'
        ]);
      allow delete: if false;
    }

    match /homework/{homeworkId} {
      allow read: if isSignedIn();
      allow create, update: if isTeacherOrClassPresident();
      allow delete: if isTeacherOrClassPresident();
    }

    match /subjects/{subjectId} {
      allow read: if isSignedIn();
      allow create: if isTeacherOrClassPresident()
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 40
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.archived == false
        && request.resource.data.keys().hasOnly([
          'name', 'color', 'archived', 'createdAt', 'updatedAt', 'createdBy'
        ]);
      allow update: if isTeacherOrClassPresident()
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'name', 'color', 'archived', 'updatedAt'
        ])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 40;
      allow delete: if isTeacherOrClassPresident();
    }

    match /announcements/{announcementId} {
      allow read: if isSignedIn();
      allow create: if isTeacherOrClassPresident()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 120
        && request.resource.data.content is string
        && request.resource.data.content.size() > 0
        && request.resource.data.content.size() <= 5000
        && request.resource.data.pinned is bool
        && request.resource.data.archived == false
        && request.resource.data.keys().hasOnly([
          'title', 'content', 'pinned', 'attachmentUrls', 'createdBy',
          'createdAt', 'updatedAt', 'archived', 'authorName', 'slug'
        ]);
      allow update: if isTeacherOrClassPresident()
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'title', 'content', 'pinned', 'updatedAt'
        ])
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 120
        && request.resource.data.content is string
        && request.resource.data.content.size() > 0
        && request.resource.data.content.size() <= 5000
        && request.resource.data.pinned is bool;
      allow delete: if isTeacherOrClassPresident();
    }

    match /events/{eventId} {
      allow read: if isSignedIn()
        && (resource.data.isPublic == true || resource.data.createdBy == request.auth.uid);
      allow create: if isSignedIn()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 100
        && request.resource.data.date is string
        && request.resource.data.isPublic is bool
        && request.resource.data.description is string
        && request.resource.data.time is string
        && request.resource.data.type in ['Homework', 'Test', 'Reminder', 'Event']
        && request.resource.data.keys().hasOnly([
          'title', 'description', 'date', 'time', 'type', 'isPublic',
          'createdBy', 'createdAt', 'updatedAt', 'archived'
        ]);
      allow update: if isSignedIn()
        && resource.data.createdBy == request.auth.uid
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'title', 'description', 'date', 'time', 'type', 'isPublic', 'updatedAt'
        ])
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 100
        && request.resource.data.date is string
        && request.resource.data.isPublic is bool
        && request.resource.data.description is string
        && request.resource.data.time is string
        && request.resource.data.type in ['Homework', 'Test', 'Reminder', 'Event'];
      allow delete: if isSignedIn()
        && resource.data.createdBy == request.auth.uid;
    }

    match /tests/{testId} {
      allow read: if isSignedIn();
      allow create, update: if isTeacherOrClassPresident();
      allow delete: if isTeacherOrClassPresident();
    }

    match /xpTransactions/{transactionId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }

    match /aiUsage/{usageId} {
      allow read: if isSignedIn();
      allow create, update: if isTeacherOrClassPresident();
      allow delete: if isTeacherOrClassPresident();
    }
  }
}
